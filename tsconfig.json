{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["./src/core/*"],
      "@features/*": ["./src/features/*"],
      "@auth/*": ["./src/features/auth/*"],
      "@settings/*": ["./src/features/settings/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
